{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "What the paper claims and does, without judgement"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "One item per strength"
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "One item per weakness: what, where, and what evidence would resolve it; most important first"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Questions whose answers could change the assessment"
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "ICLR scale: 1, 3, 5, 6, 8 or 10"
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "ICLR confidence, 1 to 5"
    }
  },
  "required": [
    "summary",
    "strengths",
    "weaknesses",
    "questions",
    "score",
    "confidence"
  ],
  "additionalProperties": false
}
