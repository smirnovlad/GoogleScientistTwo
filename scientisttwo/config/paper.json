{
  "name": "paper",
  "description": "ScientistTwo's configuration, App. A.2, with our values where it sets none (docs/architecture/engine.md, section 8).",
  "limits": {
    "limitation_rounds": 16,
    "n_seed": 6,
    "novelty_refs": 2,
    "n0": 2,
    "n_eng_subset": 2,
    "n_eng_full": 2,
    "n_k": 1,
    "n_e": 1,
    "K": 4,
    "S": 4,
    "n_p": 5,
    "n_abl": 1,
    "review_threshold": 8,
    "n_t": 3,
    "n_peer": 2,
    "n_meta": 1
  },
  "stages": {
    "limitations":  {"counting": "critic_calls", "exhaustion": "keep_last"},
    "subset":       {"counting": "refinements",  "exhaustion": "discard"},
    "full":         {"counting": "refinements",  "exhaustion": "discard"},
    "ablation":     {"counting": "refinements",  "exhaustion": "keep_best", "reject_ends_run": true},
    "peer_review":  {"counting": "refinements",  "exhaustion": "keep_last"},
    "meta":         {"counting": "refinements",  "exhaustion": "keep_best"}
  },
  "guard": {"min_delta": 0.0},
  "integrity": {"spec_filter": true, "reference_check": true, "method_code_audit": true, "final_judge": true},
  "parallel": 2,
  "budget": {
    "max_agent_calls": 800,
    "max_coding_sessions": 200,
    "max_hours": 96,
    "max_equiv_usd": null,
    "max_five_hour_utilization": 0.98,
    "max_seven_day_utilization": 0.95
  },
  "rate_limit": {"max_wait_minutes": 300},
  "retries": {"transient": 2, "invalid_output": 1},
  "routing": {}
}
