(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/dev"))
(deny file-write* (subpath "<engine>/runs/digits-quick-1"))
(allow file-write* (subpath "<scratchpad>/probe1/eval"))
(deny file-write* (subpath "<engine>/runs/digits-quick-1/workspaces/s3.full0") (subpath "<engine>/runs/digits-quick-1/public_data"))
(deny file-read* (subpath "<engine>/runs"))
(allow file-read* (subpath "<engine>/runs/digits-quick-1"))
(deny file-read* file-write* (subpath "<engine>/runs/digits-quick-1/.locked-harness") (subpath "<engine>/tasks/digits") (subpath "~/miniconda3/lib/python3.13/site-packages/sklearn/datasets/data") (subpath "~/.ssh") (subpath "~/.aws") (subpath "~/.gnupg") (subpath "~/.config/gh") (subpath "~/.netrc") (subpath "~/.docker") (subpath "~/.kube") (regex #"/\.locked-harness(/|$)"))
(deny network*)