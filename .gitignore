# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/

# Secrets and machine-local settings: never committed (this repository is public)
.env
.env.*
!.env.example
.secrets/
.claude/settings.local.json

# One worktree per task, and the brief a coordinating session leaves in one for the task's
# session (docs/process/worktrees-and-sessions.md)
.claude/worktrees/
.claude/brief.md

# Run outputs, datasets and model artefacts: large, reproducible from their records, or licensed
runs/
data/
checkpoints/
*.ckpt
*.pt
*.safetensors
wandb/

# OS
.DS_Store

# Downloaded paper sources and other re-fetchable inputs (playground/paper/fetch_sources.sh)
.cache/

# A task's generated data: rebuilt deterministically by its `prepare` command, pinned by hash in a run
tasks/*/data/
tasks/*/harness/inputs/
tasks/*/harness/labels/

# Logs of local engine runs
/runs-*.log
